<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Audit express climat{% endblock %}</title>
        {% block head_extras %}{% endblock %}
        <style>
            :root {
                --bg: #0f1f1c;
                --panel: #132b25;
                --accent: #3ddc97;
                --muted: #9bb3ad;
                --text: #f3f7f5;
                --warning: #ffb347;
            }
            * { box-sizing: border-box; }
            body {
                margin: 0;
                font-family: Georgia, "Times New Roman", serif;
                background: radial-gradient(circle at 10% 20%, #17332c 0%, #0f1f1c 55%, #0b1714 100%);
                color: var(--text);
                min-height: 100vh;
            }
            a { color: inherit; text-decoration: none; }
            header {
                padding: 24px 48px;
                display: flex;
                justify-content: space-between;
                align-items: center;
            }
            .brand {
                font-size: 1.4rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
            }
            main {
                padding: 32px 48px 80px;
            }
            .grid {
                display: grid;
                gap: 24px;
            }
            .card {
                background: rgba(19, 43, 37, 0.85);
                border: 1px solid rgba(61, 220, 151, 0.2);
                border-radius: 16px;
                padding: 24px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.25);
            }
            .cta {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                padding: 12px 20px;
                background: var(--accent);
                color: #0f1f1c;
                border-radius: 999px;
                font-weight: 600;
                letter-spacing: 0.03em;
            }
            .cta.loading {
                pointer-events: none;
                opacity: 0.85;
            }
            .muted { color: var(--muted); }
            form {
                display: grid;
                gap: 16px;
            }
            label { display: block; margin-bottom: 6px; font-family: "Trebuchet MS", "Segoe UI", sans-serif; }
            input, select {
                width: 100%;
                padding: 12px 14px;
                border-radius: 10px;
                border: 1px solid rgba(255, 255, 255, 0.2);
                background: rgba(10, 22, 19, 0.8);
                color: var(--text);
            }
            .form-error {
                margin-top: 6px;
                color: var(--warning);
                font-family: "Trebuchet MS", "Segoe UI", sans-serif;
                font-size: 0.9rem;
            }
            input[type="checkbox"] {
                width: 18px;
                height: 18px;
                accent-color: var(--accent);
            }
            .checkbox-row {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-top: 6px;
            }
            .form-row {
                display: grid;
                gap: 16px;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            }
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                padding: 12px 20px;
                border-radius: 999px;
                border: none;
                background: linear-gradient(120deg, #3ddc97 0%, #9cf5c8 100%);
                color: #0f1f1c;
                font-weight: 700;
                letter-spacing: 0.03em;
                cursor: pointer;
                box-shadow: 0 12px 30px rgba(61, 220, 151, 0.25);
            }
            .btn:hover {
                transform: translateY(-1px);
            }
            .btn[disabled] {
                cursor: not-allowed;
                opacity: 0.75;
                transform: none;
                box-shadow: none;
            }
            .spinner {
                width: 14px;
                height: 14px;
                border: 2px solid rgba(15, 31, 28, 0.35);
                border-top-color: #0f1f1c;
                border-radius: 50%;
                display: inline-block;
                animation: spin 0.8s linear infinite;
            }
            @keyframes spin {
                to { transform: rotate(360deg); }
            }
            .info {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 18px;
                height: 18px;
                border-radius: 50%;
                background: rgba(255, 255, 255, 0.15);
                color: var(--text);
                font-family: "Trebuchet MS", "Segoe UI", sans-serif;
                font-size: 0.75rem;
                margin-left: 6px;
                cursor: help;
                border: 1px solid rgba(255, 255, 255, 0.2);
            }
            .badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 12px;
                border-radius: 999px;
                background: rgba(255, 255, 255, 0.1);
                font-family: "Trebuchet MS", "Segoe UI", sans-serif;
                font-size: 0.85rem;
            }
            .score {
                font-size: 2.4rem;
                font-weight: 600;
                color: var(--accent);
                font-family: "Trebuchet MS", "Segoe UI", sans-serif;
            }
            .pill {
                padding: 6px 12px;
                border-radius: 999px;
                font-size: 0.85rem;
                background: rgba(61, 220, 151, 0.2);
                font-family: "Trebuchet MS", "Segoe UI", sans-serif;
            }
            .actions-list {
                display: grid;
                gap: 12px;
            }
            .action-item {
                padding: 16px;
                border-radius: 12px;
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid rgba(255, 255, 255, 0.1);
            }
            @media (max-width: 720px) {
                header, main { padding: 24px; }
            }
        </style>
    </head>
    <body>
        <header>
            <div class="brand">Clima Audit</div>
            <a class="cta" href="{{ path('audit_new') }}" data-loading-label="Ouverture...">Demarrer l'audit</a>
        </header>
        <main>
            {% block body %}{% endblock %}
        </main>
        <script>
            (function () {
                const links = document.querySelectorAll('a.cta[data-loading-label]');
                if (!links.length) {
                    return;
                }
                links.forEach((link) => {
                    link.addEventListener('click', function () {
                        if (link.classList.contains('loading')) {
                            return;
                        }
                        link.classList.add('loading');
                        link.setAttribute('aria-busy', 'true');
                        const originalText = link.textContent || '';
                        link.dataset.originalLabel = originalText;
                        const loadingLabel = link.getAttribute('data-loading-label') || 'Chargement...';
                        link.textContent = loadingLabel + ' ';
                        const spinner = document.createElement('span');
                        spinner.className = 'spinner';
                        link.appendChild(spinner);
                    });
                });
            })();
        </script>
    </body>
</html>
